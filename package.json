{
  "name": "@unfoldit/mcp-server",
  "version": "0.1.1",
  "description": "MCP server for Unfold It (https://unfoldit.ai) -- create goals with AI-generated plans, distribute claim links, and track progress via AI assistants",
  "type": "module",
  "bin": {
    "unfoldit-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "unfold",
    "goal-planning",
    "ai-assistant",
    "model-context-protocol"
  ],
  "author": "Unfold",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
